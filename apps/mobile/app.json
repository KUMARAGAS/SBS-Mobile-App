{
  "expo": {
    "name": "Mobileapp",
    "slug": "Mobileapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobileapp",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#000814",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.amilasavinda20.Mobileapp",
      "backgroundColor": "#000814"
    },
    "android": {
      "backgroundColor": "#000814",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.amilasavinda20.Mobileapp"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "backgroundColor": "#000814",
      "splash": {
        "backgroundColor": "#000814",
        "image": "./assets/images/sbs-logo.png",
        "resizeMode": "contain"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000814",
          "image": "./assets/images/sbs-logo.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#000814",
            "image": "./assets/images/sbs-logo.png",
            "imageWidth": 200
          }
        }
      ],
      "expo-secure-store",
      "@clerk/expo"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d3915dae-dfc8-4039-8bbd-53a30e39129d"
      }
    }
  }
}
