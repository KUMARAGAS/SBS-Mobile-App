{
  "name": "@sbs/api",
  "version": "0.1.0",
  "private": true,
  "description": "SBS Field Service API — Node 22 + Express 5 + TypeScript, 4-layer architecture (PLAN.md §8.5).",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:push": "drizzle-kit push --config drizzle.config.ts",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.74",
    "@neondatabase/serverless": "^1.2.0",
    "@sbs/shared": "*",
    "cors": "^2.8.5",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@sbs/config": "*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.0"
  }
}
